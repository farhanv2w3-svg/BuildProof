# BuildProof environment variables — placeholders only.
# Copy this file to `.env` and paste REAL values from YOUR BuildProof Supabase project.
# Never use a DeenPath (or any other project's) Supabase URL or key here.
# The anon/public key is safe to expose to the browser; RLS protects the data.

VITE_SUPABASE_URL=https://YOUR-BUILDPROOF-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-BUILDPROOF-PUBLISHABLE-ANON-KEY
VITE_APP_ENV=development
